# Copia este archivo como .env y completa con los datos de tu proyecto de Supabase
# (Supabase › Project Settings › API). La anon key es pública por diseño: la protegen las políticas RLS.
# NUNCA pongas aquí la service_role key: esa solo vive en la Edge Function, del lado del servidor.
EXPO_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=tu-anon-key
